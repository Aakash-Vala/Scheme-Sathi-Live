# Scheme Sathi • Production Environment Configuration Template
# Copy this file to .env and fill in your credentials

# MongoDB Atlas Cloud Connection String
# Example: mongodb+srv://sih_admin:<password>@cluster0.abcde.mongodb.net/scheme_sathi_sih?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/scheme_sathi_sih?retryWrites=true&w=majority
MONGO_DB_NAME=scheme_sathi_sih

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# CORS Allowed Origins (comma-separated or * for all)
CORS_ORIGINS=*

# Optional Secret Key for JWT / Sessions
SECRET_KEY=scheme-sathi-production-super-secret-key-change-this-in-prod
